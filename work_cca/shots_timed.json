{
  "fps": 30,
  "end": 224.81,
  "shots": [
    {
      "n": 1,
      "start": 0.0,
      "end": 8.0,
      "dur": 8.0,
      "text": "1985 y\u0131l\u0131yd\u0131 ve Amerika Birle\u015fik Devletleri son derece ciddi bir ulusal krizle kar\u015f\u0131 kar\u015f\u0131yayd\u0131."
    },
    {
      "n": 2,
      "start": 9.0,
      "end": 14.0,
      "dur": 5.0,
      "text": "Hay\u0131r, sovyetler birli\u011fi n\u00fckleer f\u00fczeleri ate\u015flememi\u015fti."
    },
    {
      "n": 3,
      "start": 14.0,
      "end": 17.0,
      "dur": 3.0,
      "text": "\u00c7ok daha korkun\u00e7 bir \u015fey olmu\u015ftu."
    },
    {
      "n": 4,
      "start": 17.0,
      "end": 19.0,
      "dur": 2.0,
      "text": "Coca-Cola tad\u0131n\u0131 de\u011fi\u015ftirmi\u015fti."
    },
    {
      "n": 5,
      "start": 20.0,
      "end": 24.0,
      "dur": 4.0,
      "text": "Olay\u0131 anlamak i\u00e7in biraz geriye gitmemiz gerekiyor."
    },
    {
      "n": 6,
      "start": 24.0,
      "end": 31.0,
      "dur": 7.0,
      "text": "1980'lerin ba\u015f\u0131nda Coca-Cola d\u00fcnyan\u0131n tart\u0131\u015fmas\u0131z en popular gazl\u0131 i\u00e7eciydi."
    },
    {
      "n": 7,
      "start": 32.0,
      "end": 34.0,
      "dur": 2.0,
      "text": "Ancak atlantadaki \u015firket merkezinde,"
    },
    {
      "n": 8,
      "start": 35.0,
      "end": 39.0,
      "dur": 4.0,
      "text": "klimal\u0131 ofislerinde oturan y\u00f6neticiler pecih\u00e2lde terliyordu."
    },
    {
      "n": 9,
      "start": 39.0,
      "end": 44.0,
      "dur": 5.0,
      "text": "\u00c7\u00fcnk\u00fc ezelir akibleri Pepsi, sinsice pazarpay\u0131 \u00e7al\u0131yordu."
    },
    {
      "n": 10,
      "start": 45.0,
      "end": 49.0,
      "dur": 4.0,
      "text": "Pepsi, Pepsi Challenge ad\u0131n\u0131 verdi\u011fi k\u00f6r tad\u0131m tesleri d\u00fczenliyor"
    },
    {
      "n": 11,
      "start": 49.0,
      "end": 52.0,
      "dur": 3.0,
      "text": "ve insanlara g\u00f6zleri kapal\u0131 iki barda\u011f\u0131 tatl\u0131r\u0131yordu."
    },
    {
      "n": 12,
      "start": 53.0,
      "end": 58.0,
      "dur": 5.0,
      "text": "Sonu\u00e7, insanlar daha \u015fekerli olan Pepsi'yi se\u00e7iyordu."
    },
    {
      "n": 13,
      "start": 59.0,
      "end": 63.0,
      "dur": 4.0,
      "text": "Coca-Cola y\u00f6netiminin bu duruma tepkisi son derece ras y\u00f6nel ve sakince oldu."
    },
    {
      "n": 14,
      "start": 64.0,
      "end": 65.0,
      "dur": 1.0,
      "text": "Yani paniklediler."
    },
    {
      "n": 15,
      "start": 66.0,
      "end": 71.0,
      "dur": 5.0,
      "text": "\u015eirket dahilleri hemen bir araya geldi ve tarihi ge\u00e7ecek bir karar ald\u0131."
    },
    {
      "n": 16,
      "start": 72.0,
      "end": 78.0,
      "dur": 6.0,
      "text": "E\u011fer insanlar tatl\u0131 seviyorsa, biz de 99 y\u0131ll\u0131k form\u00fcl\u00fcm\u00fcz\u00fc \u00e7\u00f6pe at\u0131p i\u00e7ece\u011fi daha tatl\u0131 yapar\u0131z."
    },
    {
      "n": 17,
      "start": 79.0,
      "end": 84.0,
      "dur": 5.0,
      "text": "Yakla\u015f\u0131k 200.000 ki\u015fi \u00fczerinde gizli laborat\u0131 artad\u0131mlar\u0131 yapt\u0131lar."
    },
    {
      "n": 18,
      "start": 85.0,
      "end": 87.0,
      "dur": 2.0,
      "text": "\u00c7o\u011fu denek yeni form\u00fcl\u00fc be\u011fendi."
    },
    {
      "n": 19,
      "start": 88.0,
      "end": 93.0,
      "dur": 5.0,
      "text": "Ve 23 Nisan 1985'de Coca-Cola GEO'su,"
    },
    {
      "n": 20,
      "start": 94.0,
      "end": 99.0,
      "dur": 5.0,
      "text": "Roberto Goiz\u00fc eta kameralar\u0131n kar\u015f\u0131s\u0131na ge\u00e7ip gururla New Coke uduyordu."
    },
    {
      "n": 21,
      "start": 100.0,
      "end": 105.0,
      "dur": 5.0,
      "text": "y\u00f6neticiler hissesenetlerinin u\u00e7mas\u0131n\u0131 ve ofislerine tebrik telgraflar\u0131 ya\u011fmas\u0131n\u0131 bekliyordu."
    },
    {
      "n": 22,
      "start": 106.0,
      "end": 108.0,
      "dur": 2.0,
      "text": "Fanfekt \u00f6yle olmad\u0131."
    },
    {
      "n": 23,
      "start": 108.0,
      "end": 112.0,
      "dur": 4.0,
      "text": "Amerikan halk\u0131 bu durumu bir \u00fcr\u00fcn de\u011fi\u015fikli\u011fi olarak de\u011fil."
    },
    {
      "n": 24,
      "start": 113.0,
      "end": 118.0,
      "dur": 5.0,
      "text": "Ki\u015fisel bir hakaret ve anayasal haklar\u0131na a\u00e7\u0131k bir sald\u0131r\u0131 olarak alg\u0131lad\u0131."
    },
    {
      "n": 25,
      "start": 119.0,
      "end": 123.0,
      "dur": 4.0,
      "text": "\u0130nsanlar s\u00fcper marketleri ya\u011fmalay\u0131p eski kolakutular\u0131n\u0131,"
    },
    {
      "n": 26,
      "start": 123.0,
      "end": 125.0,
      "dur": 2.0,
      "text": "bodrumlar\u0131na istiflemeye ba\u015flad\u0131."
    },
    {
      "n": 27,
      "start": 127.0,
      "end": 129.0,
      "dur": 2.0,
      "text": "\u015eirket Genel Merkezi,"
    },
    {
      "n": 28,
      "start": 129.0,
      "end": 133.0,
      "dur": 4.0,
      "text": "g\u00fcnde 8.000'den fazla \u00f6fkeli telefon \u00e7a\u011fr\u0131s\u0131 almaya ba\u015flad\u0131."
    },
    {
      "n": 29,
      "start": 133.0,
      "end": 136.0,
      "dur": 3.0,
      "text": "Hatta arayan ya\u015fl\u0131 bir kad\u0131n GEO'ya,"
    },
    {
      "n": 30,
      "start": 136.0,
      "end": 139.0,
      "dur": 3.0,
      "text": "kocam \u00f6ld\u00fc\u011f\u00fcnde eski cola i\u00e7mi\u015ftim,"
    },
    {
      "n": 31,
      "start": 139.0,
      "end": 142.0,
      "dur": 3.0,
      "text": "an\u0131lar\u0131m\u0131 \u00e7ald\u0131\u011f\u0131n\u0131z canavarlar diyerek a\u011fl\u0131yordu."
    },
    {
      "n": 32,
      "start": 143.0,
      "end": 145.0,
      "dur": 2.0,
      "text": "K\u00fcbali'leri Fidel Castro bile,"
    },
    {
      "n": 33,
      "start": 145.0,
      "end": 146.0,
      "dur": 1.0,
      "text": "New Coke'u,"
    },
    {
      "n": 34,
      "start": 146.0,
      "end": 150.0,
      "dur": 4.0,
      "text": "Amerikan imperializminin kesin \u00e7\u00f6k\u00fc\u015f\u00fc olarak ilan etti."
    },
    {
      "n": 35,
      "start": 151.0,
      "end": 153.0,
      "dur": 2.0,
      "text": "Atlan ta sokaklar\u0131nda protestocular,"
    },
    {
      "n": 36,
      "start": 153.0,
      "end": 155.0,
      "dur": 2.0,
      "text": "New Coke kutular\u0131n\u0131,"
    },
    {
      "n": 37,
      "start": 155.0,
      "end": 156.0,
      "dur": 1.0,
      "text": "kanalizasyona d\u00f6kt\u00fc"
    },
    {
      "n": 38,
      "start": 156.0,
      "end": 159.0,
      "dur": 3.0,
      "text": "ve \u015firket alehine toplu davalar a\u00e7\u0131ld\u0131."
    },
    {
      "n": 39,
      "start": 160.0,
      "end": 164.0,
      "dur": 4.0,
      "text": "Tam 79 g\u00fcn s\u00fcren bu ulusal hislerinin ard\u0131ndan,"
    },
    {
      "n": 40,
      "start": 164.0,
      "end": 165.0,
      "dur": 1.0,
      "text": "Coca-Cola pes etti."
    },
    {
      "n": 41,
      "start": 166.0,
      "end": 169.0,
      "dur": 3.0,
      "text": "11 Temmuz 1980,"
    },
    {
      "n": 42,
      "start": 169.0,
      "end": 171.0,
      "dur": 2.0,
      "text": "5 de kameralar yeniden a\u00e7\u0131ld\u0131"
    },
    {
      "n": 43,
      "start": 171.0,
      "end": 176.0,
      "dur": 5.0,
      "text": "ve eski form\u00fcl\u00fcn Coca-Cola klasik ad\u0131yla geri d\u00f6nd\u00fc\u011f\u00fc duyuruldu."
    },
    {
      "n": 44,
      "start": 176.0,
      "end": 178.0,
      "dur": 2.0,
      "text": "Amerikan Senatusu,"
    },
    {
      "n": 45,
      "start": 178.0,
      "end": 181.0,
      "dur": 3.0,
      "text": "bu haberi oturmaras\u0131nda alk\u0131\u015flarla kutlad\u0131."
    },
    {
      "n": 46,
      "start": 182.0,
      "end": 184.0,
      "dur": 2.0,
      "text": "\u0130\u015fin en absur taraf\u0131 ne miydi?"
    },
    {
      "n": 47,
      "start": 185.0,
      "end": 187.0,
      "dur": 2.0,
      "text": "Eski kolara defa d\u00f6nd\u00fc\u011f\u00fcnde sat\u0131\u015flar patlad\u0131"
    },
    {
      "n": 48,
      "start": 187.0,
      "end": 191.0,
      "dur": 4.0,
      "text": "ve Coca-Cola pepsiyi tarihindeki en b\u00fcy\u00fck farkl\u0131 ezdi."
    },
    {
      "n": 49,
      "start": 192.0,
      "end": 196.0,
      "dur": 4.0,
      "text": "Baz\u0131lar\u0131 bunun tarihin en dahi pazarlama komplusu oldu\u011funu iddia etti."
    },
    {
      "n": 50,
      "start": 197.0,
      "end": 199.0,
      "dur": 2.0,
      "text": "CEO Goiz\u00fc etayse d\u00fcr\u00fcst davrand\u0131."
    },
    {
      "n": 51,
      "start": 200.0,
      "end": 202.0,
      "dur": 2.0,
      "text": "O kadar zeki de\u011filiz"
    },
    {
      "n": 52,
      "start": 202.0,
      "end": 204.0,
      "dur": 2.0,
      "text": "ve o kadar aptal da de\u011filiz."
    },
    {
      "n": 53,
      "start": 205.0,
      "end": 207.0,
      "dur": 2.0,
      "text": "\u0130zledi\u011finiz i\u00e7in te\u015fekk\u00fcrler."
    },
    {
      "n": 54,
      "start": 208.0,
      "end": 211.0,
      "dur": 3.0,
      "text": "E\u011fer \u015firketinizin y\u00fcz y\u0131ll\u0131k tarifini \u00e7\u00f6pe atmak \u00fczereyseniz"
    },
    {
      "n": 55,
      "start": 211.0,
      "end": 213.0,
      "dur": 2.0,
      "text": "\u00f6nce videoyu be\u011fenmeyi"
    },
    {
      "n": 56,
      "start": 213.0,
      "end": 215.0,
      "dur": 2.0,
      "text": "ve abone olmay\u0131 unutmay\u0131n."
    },
    {
      "n": 57,
      "start": 216.0,
      "end": 218.0,
      "dur": 2.0,
      "text": "James B. Sarahke"
    },
    {
      "n": 58,
      "start": 218.0,
      "end": 221.0,
      "dur": 3.0,
      "text": "ve di\u011fer t\u00fcm patrayon destek\u00e7ilerimize te\u015fekk\u00fcr ederiz."
    },
    {
      "n": 59,
      "start": 221.0,
      "end": 224.0,
      "dur": 3.0,
      "text": "Bir sonraki kurum salfelakette g\u00f6r\u00fc\u015fmek \u00fczere."
    }
  ]
}